{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "usersRoute": {
        "ClusterId": "usersCluster",
        "Match": { "Path": "/User/{**catch-all}" }
      },
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": { "Path": "/Auth/{**catch-all}" }
      },
      "erpRoute": {
        "ClusterId": "erpCluster",
        "Match": { "Path": "/ERP/{**catch-all}" }
      }
    },
    "Clusters": {
      "usersCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5001" } }
      },
      "authCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5002" } }
      },
      "erpCluster": {
        "Destinations": { "d1": { "Address": "http://localhost:5271" } }
      }
      
    }
  },
  "AllowedHosts": "*"
}
